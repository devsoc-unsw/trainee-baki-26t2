# Copy this file to .env.local for development. Never commit .env.local.
# Every variable here should be treated as required unless marked optional;
# the app is designed to boot with the defaults shown, but real deployments
# should set explicit values.
#
# Naming convention: any variable that must be readable in the browser is
# prefixed with NEXT_PUBLIC_. Everything else stays server-side.


# --- Application ---

# Absolute URL the app is served from. Used to construct self-referential
# links (e.g. for share URLs, OG tags, canonical URLs) and to let server
# code build fully-qualified paths back to its own route handlers.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- TheMealDB ---

# Base URL for TheMealDB's public v1 API. Change to a mirror or to a
# self-hosted proxy when TheMealDB rate-limits are a problem.
MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1


# --- Default location ---
# Latitude/longitude used to compute distance from stores when the
# browser does not (or cannot) share geolocation. Falls back to Sydney
# CBD, which matches the mocked Coles/Woolworths coordinates in
# src/lib/mockData.ts.
NEXT_PUBLIC_DEFAULT_LATITUDE=-33.8688
NEXT_PUBLIC_DEFAULT_LONGITUDE=151.2093


# --- Persistence (not yet used) ---

# Postgres connection string for the real backend that will replace
# src/lib/mockData.ts. Left blank means "use the in-memory mock".
# When populated, expect a schema migration step to run before boot.
DATABASE_URL=


# --- Store price feeds (not yet used) ---

# Base URLs for the store-specific price feed adapters that will
# replace the mocked storePricing map. Both are unauthenticated by
# project policy (see AGENTS.md); if a real feed requires a key,
# the integration needs a design discussion first, not a hidden env
# var.
COLES_FEED_URL=
WOOLWORTHS_FEED_URL=
